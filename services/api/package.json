{
  "name": "@carebridge/api",
  "private": true,
  "version": "0.4.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema ../../database/prisma/schema.prisma",
    "db:push": "prisma db push --schema ../../database/prisma/schema.prisma",
    "db:setup": "prisma db push --schema ../../database/prisma/schema.prisma && tsx ../../database/prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --schema ../../database/prisma/schema.prisma && tsx ../../database/prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@prisma/client": "6.19.0",
    "fastify": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prisma": "6.19.0",
    "tsx": "latest",
    "typescript": "5.9.2",
    "vitest": "latest"
  }
}
