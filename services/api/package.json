{
  "name": "@carebridge/api",
  "private": true,
  "version": "0.4.0",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "db:generate": "pnpm --filter @carebridge/database db:generate",
    "db:push": "pnpm --filter @carebridge/database db:push",
    "db:setup": "pnpm --filter @carebridge/database db:setup",
    "db:reset": "pnpm --filter @carebridge/database db:reset",
    "uat:integration": "tsx src/uatSmoke.ts",
    "uat:care-requests": "tsx src/uatCareRequests.ts",
    "uat:security": "tsx src/uatSecurity.ts",
    "uat:production": "tsx src/uatProduction.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@prisma/client": "6.19.0",
    "fastify": "5.12.8",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prisma": "6.19.0",
    "tsx": "latest",
    "typescript": "5.9.2",
    "vitest": "latest"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/uat*.js"
  ]
}
