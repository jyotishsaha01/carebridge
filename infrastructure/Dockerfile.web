FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts
ARG APP=patient
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_DOCTOR_APP_URL
ARG NEXT_PUBLIC_ADMIN_APP_URL
ARG NEXT_PUBLIC_PAYMENT_CHECKOUT_ORIGINS
ENV NEXT_TELEMETRY_DISABLED=1
RUN case "$APP" in patient|doctor|admin) ;; *) exit 1 ;; esac && pnpm --filter "@carebridge/$APP" build
RUN mkdir -p "/release/apps/$APP/.next" "apps/$APP/public" && \
    cp -a "apps/$APP/.next/standalone/." /release/ && \
    cp -a "apps/$APP/.next/static" "/release/apps/$APP/.next/static" && \
    cp -a "apps/$APP/public" "/release/apps/$APP/public"

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ARG APP=patient
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 CAREBRIDGE_APP=$APP
COPY --from=build --chown=node:node /release/ ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "exec node apps/$CAREBRIDGE_APP/server.js"]
