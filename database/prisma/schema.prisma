generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  passwordHash            String?
  emailVerifiedAt         DateTime?
  role                    String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  patient                 Patient?
  doctor                  Doctor?
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  supportTickets          SupportTicket[]
  reviewedCredentials     DoctorCredential[] @relation("CredentialReviewer")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  outcome      String
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      String
  channel   String @default("IN_APP")
  status    String  @default("UNREAD")
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
}

model Patient {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  country   String   @default("US")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  medicalIntake MedicalIntake[]
  documents MedicalDocument[]
  consultations Consultation[]
  carePlans CarePlan[]
  careRequests CareRequest[]
}

model Specialty {
  id String @id @default(cuid())
  name String @unique
  doctors Doctor[]
}

model Doctor {
  id String @id @default(cuid())
  userId String @unique
  specialtyId String
  slug String @unique
  name String
  initials String
  location String
  rating Float
  experienceYears Int
  consultationPriceUsd Float
  expertise Json
  bio String
  status String @default("PENDING")
  isVerified Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id])
  costComparison CostComparison?
  availability AvailabilitySlot[]
  appointments Appointment[]
  consultations Consultation[]
  credentials DoctorCredential[]
}

model CostComparison {
  id String @id @default(cuid())
  doctorId String @unique
  patientCountry String
  comparableLowUsd Float
  comparableHighUsd Float
  sourceLabel String
  disclaimer String
  updatedAt DateTime @updatedAt
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model AvailabilitySlot {
  id String @id @default(cuid())
  doctorId String
  startsAt DateTime
  endsAt DateTime
  status String @default("AVAILABLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  @@unique([doctorId, startsAt])
  @@index([doctorId, startsAt, status])
}

model Appointment {
  id String @id @default(cuid())
  patientId String
  doctorId String
  scheduledAt DateTime
  durationMin Int @default(30)
  status String @default("BOOKED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields: [patientId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])
  medicalIntake MedicalIntake?
  documents MedicalDocument[]
  consultation Consultation?
  @@unique([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
}

model MedicalIntake {
  id String @id @default(cuid())
  appointmentId String @unique
  patientId String
  reasonForVisit String?
  symptoms String?
  allergies String?
  medications String?
  medicalHistory String?
  surgeries String?
  familyHistory String?
  consentToConsult Boolean @default(false)
  consentedAt DateTime?
  status String @default("DRAFT")
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId, updatedAt])
}

model MedicalDocument {
  id String @id @default(cuid())
  patientId String
  appointmentId String?
  originalFileName String
  storageKey String
  contentType String
  sizeBytes Int
  createdAt DateTime @default(now())
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  @@index([patientId, createdAt])
  @@index([appointmentId])
}

model Consultation {
  id String @id @default(cuid())
  appointmentId String @unique
  patientId String
  doctorId String
  status String @default("SCHEDULED")
  startedAt DateTime?
  endedAt DateTime?
  summary String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  notes ClinicalNote[]
  prescription Prescription?
  followUps FollowUp[]
  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
}

model ClinicalNote {
  id String @id @default(cuid())
  consultationId String
  assessment String?
  findings String?
  recommendations String?
  privateNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  @@index([consultationId, createdAt])
}

model Prescription {
  id String @id @default(cuid())
  consultationId String @unique
  instructions String?
  issuedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  items PrescriptionItem[]
}

model PrescriptionItem {
  id String @id @default(cuid())
  prescriptionId String
  medication String
  dose String?
  frequency String?
  duration String?
  route String?
  instructions String?
  createdAt DateTime @default(now())
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  @@index([prescriptionId])
}

model FollowUp {
  id String @id @default(cuid())
  consultationId String
  dueAt DateTime?
  instructions String?
  status String @default("RECOMMENDED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  @@index([consultationId, status])
}

model CarePlan {
  id String @id @default(cuid())
  patientId String
  title String
  description String?
  status String @default("DRAFT")
  coordinatorNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tasks CarePlanTask[]
  @@index([patientId, status, updatedAt])
}

model CarePlanTask {
  id String @id @default(cuid())
  carePlanId String
  title String
  description String?
  dueAt DateTime?
  status String @default("TODO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  @@index([carePlanId, status, dueAt])
}

model CareRequest {
  id String @id @default(cuid())
  patientId String
  type String
  status String @default("REQUESTED")
  title String
  description String?
  country String?
  targetDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId, status, createdAt])
}



model DoctorCredential {
  id               String           @id @default(cuid())
  doctorId         String
  type             String
  licenseNumber    String
  jurisdiction     String
  documentName     String?
  storageKey       String?
  status           String @default("PENDING")
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  doctor           Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  reviewedByUser   User?            @relation("CredentialReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  @@index([doctorId, status, createdAt])
  @@index([reviewedByUserId, reviewedAt])
}


model SupportTicket {
  id         String              @id @default(cuid())
  userId     String
  category   String
  message    String
  status     String @default("OPEN")
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  resolvedAt DateTime?
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, createdAt])
  @@index([status, updatedAt])
}
