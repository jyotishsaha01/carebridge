# Local development only — synthetic data; never use these values in production.
NODE_ENV=development
# Relative file URLs resolve against database/prisma/schema.prisma.
DATABASE_URL=file:./dev.db
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000
ALLOW_DEMO_AUTH=true
# Optional exact proxy IP/CIDRs only; keep unset for direct local access.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Browser checkout redirects remain disabled until exact provider origins are configured.
NEXT_PUBLIC_PAYMENT_CHECKOUT_ORIGINS=
# Optional, only for synthetic payment webhook tests; use a random >=32 character value.
# CAREBRIDGE_DEMO_WEBHOOK_SECRET=replace-with-a-random-local-test-value

# Production readiness gates (set only in the real deployment environment)
# These attestations alone do not implement provider integrations or MFA.
# Production readiness stays blocked until required integrations are verified.
# SECURITY_EMAIL_PROVIDER=your-provider
# REQUIRE_MFA=true
# STORAGE_PROVIDER=s3
# STORAGE_ENCRYPTION=true
# AUDIT_RETENTION_DAYS=2555
# OBSERVABILITY_ENDPOINT=https://your-telemetry-endpoint
# BACKUP_VERIFIED=true
# SECURITY_ASSESSMENT_PASSED=true
# PRIVACY_LEGAL_APPROVED=true
