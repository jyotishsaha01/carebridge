# Supply secrets through your deployment environment; do not commit real values.
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/carebridge?sslmode=require
CORS_ORIGIN=https://app.example.com,https://doctor.example.com,https://admin.example.com
ALLOW_DEMO_AUTH=false
# Optional: exact IPs/CIDRs of your actual ingress proxies; empty ignores forwarded IPs.
# TRUSTED_PROXY_CIDRS=192.0.2.10/32,2001:db8::10/128

# Set before building each Next.js app. This value is embedded in browser code.
NEXT_PUBLIC_API_URL=https://api.example.com
# Set before building the patient app if using its role selector.
NEXT_PUBLIC_DOCTOR_APP_URL=https://doctor.example.com
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.example.com
# Leave empty until the payment provider's exact HTTPS checkout origins are approved.
NEXT_PUBLIC_PAYMENT_CHECKOUT_ORIGINS=

# Operational attestations are necessary, but cannot enable unimplemented adapters.
AUDIT_RETENTION_DAYS=2555
OBSERVABILITY_ENDPOINT=
BACKUP_VERIFIED=false
SECURITY_ASSESSMENT_PASSED=false
PRIVACY_LEGAL_APPROVED=false
