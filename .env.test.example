# CareBridge QA/Test environment — synthetic data only
NODE_ENV=test
APP_ENV=qa

# Backend
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://carebridge_test:carebridge_test@localhost:5432/carebridge_test

# Auth placeholders — use environment secrets for real values
AUTH_ISSUER=https://auth.example.test
AUTH_CLIENT_ID=replace-me
AUTH_CLIENT_SECRET=replace-me

# Payments / video providers should point to sandbox/test systems only
PAYMENT_MODE=test
VIDEO_MODE=test

# Never place production credentials or real patient data here.
