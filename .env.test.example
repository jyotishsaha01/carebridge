# CareBridge QA/Test environment — synthetic data only
NODE_ENV=test
APP_ENV=qa

# Backend
API_URL=http://127.0.0.1:4000
DATABASE_URL=file:./test.db
ALLOW_DEMO_AUTH=false
REQUIRE_EMAIL_VERIFICATION=false

# Set a random password before seeding; use the same value for the UAT command.
# CAREBRIDGE_UAT_PASSWORD=replace-with-a-random-synthetic-test-password
# CAREBRIDGE_DEMO_WEBHOOK_SECRET=replace-with-a-random-value-at-least-32-characters

# To test PostgreSQL, generate the production client and supply a disposable
# postgresql:// DATABASE_URL. Never point this file at a production database.

# Never place production credentials or real patient data here.
