{
  "name": "carebridge",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "build": "pnpm -r build",
    "db:setup": "pnpm --filter @carebridge/api db:setup",
    "db:reset": "pnpm --filter @carebridge/api db:reset"
  }
}
